<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Location: lets sellers attach their current location to an ad. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Push notifications (chat + saved-search alerts) on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
      firebase_analytics pulls in play-services-measurement-api, which merges
      the advertising-ID permission into the manifest. PakBazar has no ads and
      does no attribution, and the Play Console data-safety declaration says
      the app does not use an advertising ID — Play rejects the release
      outright if the two disagree. Removing it keeps analytics working
      (only ad-targeting/attribution features depend on it) and avoids opting
      into advertising-ID policy for no benefit.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <application
        android:label="PakBazar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!--
              Hands the incoming URL path to Flutter's router instead of just
              opening the app at Home, so onGenerateRoute in app.dart receives
              e.g. /ad/{listingId}. Without this the intent filters below would
              launch the app but drop the destination.
            -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Android App Links. android:autoVerify makes Android fetch
              https://pakbazar24.com/.well-known/assetlinks.json and confirm the
              app is allowed to handle these URLs; once verified, links open
              straight in the app with no chooser. Both hosts are declared
              because the site is served from the apex and www.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="pakbazar24.com"
                      android:pathPrefix="/ad"/>
                <data android:scheme="https"
                      android:host="www.pakbazar24.com"
                      android:pathPrefix="/ad"/>
            </intent-filter>
            <!--
              Custom scheme as a fallback for contexts that strip https links
              (some in-app browsers and messaging clients), and for testing
              with `adb shell am start -a android.intent.action.VIEW -d
              "pakbazar://ad/<id>"`.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="pakbazar"/>
            </intent-filter>
        </activity>
        <!--
          What a push looks like when it arrives with the app closed.

          Without these, FCM falls back to the launcher icon for the status
          bar. Android draws that icon as a silhouette from its alpha channel,
          and the launcher icon is a filled square — so every background
          notification showed a plain white block. ic_stat_notify is a
          transparent-background silhouette of the mark, which is what the
          status bar is asking for.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
