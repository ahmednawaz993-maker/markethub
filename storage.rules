rules_version = '2';

// MarketHub Storage rules. Listing photos live under listings/.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{imageId} {
      // Photos are shown publicly inside the app.
      allow read: if true;

      // Any signed-in user may upload, but only images up to 10 MB.
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Branded promo banners. Publicly readable; uploads restricted to
    // signed-in users (images up to 10 MB) — managed by the app owner.
    match /banners/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat photos. Readable by signed-in users (URL is private to the chat);
    // signed-in users may upload images up to 8 MB.
    match /chat_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Business logos (shown on Featured Businesses + seller profiles).
    match /business_logos/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Customer Care voice messages. Readable by signed-in users (the URL is
    // private to the ticket thread); signed-in users may upload audio up to
    // 10 MB.
    match /support_voice/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Identity-verification images (selfie + CNIC) — SENSITIVE. Readable only
    // by the owner and the admin; never public. Owner uploads their own.
    match /verifications/{userId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || request.auth.token.email == 'ahmednawaz993@gmail.com');
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
