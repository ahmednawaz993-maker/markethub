rules_version = '2';

// MarketHub Storage rules.
//
// SECURITY MODEL: every writable path is scoped by the uploader's uid as the
// first path segment. Before this, all upload paths were flat and writable by
// any signed-in user, so anyone could overwrite anyone else's listing photos,
// chat images, business logo or a promo banner — and the object paths were not
// even secret, since a listing document publishes its own image URLs. The
// verifications/ path below was always scoped correctly; the rest now match it.
//
// Legacy objects live at the old flat paths. Those paths keep their public read
// so already-published images keep working, but they are no longer writable by
// anyone, which closes the overwrite vector for existing objects too.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageUnder(mb) {
      return request.resource.size < mb * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // ---------------------------------------------------------------
    // Listing photos — public read, owner-only write.
    // ---------------------------------------------------------------
    match /listings/{userId}/{imageId} {
      allow read: if true;
      allow write: if owns(userId) && isImageUnder(10);
    }

    // Legacy flat listing photos: readable so existing ads keep their
    // images, but frozen — no client may overwrite or delete them.
    match /listings/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Promo banners bought through the wallet. Users upload their own
    // artwork; an admin still moderates before it is displayed, so this
    // stays user-writable but is now scoped to the buyer.
    // ---------------------------------------------------------------
    match /banners/{userId}/{imageId} {
      allow read: if true;
      allow write: if owns(userId) && isImageUnder(10);
    }

    match /banners/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Chat photos. Download URLs carry an unguessable token and the path
    // is now uid-scoped, so a signed-in read is acceptable; writes are
    // restricted to the uploader.
    // ---------------------------------------------------------------
    match /chat_images/{userId}/{imageId} {
      allow read: if signedIn();
      allow write: if owns(userId) && isImageUnder(8);
    }

    match /chat_images/{imageId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Business logos and cover images (Featured Businesses + profiles).
    // ---------------------------------------------------------------
    match /business_logos/{userId}/{imageId} {
      allow read: if true;
      allow write: if owns(userId) && isImageUnder(5);
    }

    match /business_logos/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Customer Care voice messages.
    // ---------------------------------------------------------------
    match /support_voice/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if owns(userId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    match /support_voice/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Identity-verification images (selfie + CNIC) — SENSITIVE. Readable
    // only by the owner and the admin; never public.
    // ---------------------------------------------------------------
    match /verifications/{userId}/{fileName} {
      allow read: if signedIn()
                  && (owns(userId)
                      || request.auth.token.email == 'ahmednawaz993@gmail.com');
      allow write: if owns(userId) && isImageUnder(8);
    }

    // Anything not matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
