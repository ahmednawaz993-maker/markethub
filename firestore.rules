rules_version = '2';

// MarketHub production security rules.
// Data model:
//   listings/{id}                      public marketplace ads
//   users/{uid}                        profile (member-since)
//   users/{uid}/favorites/{listingId}  per-user saved ads
//   reports/{id}                       abuse reports (write-only for users)
//   chats/{chatId}                     buyer<->seller thread
//   chats/{chatId}/messages/{id}       individual messages
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin (full access) by verified token email (keep in sync with
    // adminEmails in the app).
    // NOTE: deliberately does NOT require email_verified.
    //
    // Both super-admin and staff identity derive from the token email, and the
    // app has only ever offered phone and email/password sign-in and never
    // called sendEmailVerification — so no existing account, including the
    // owner's, has a verified email. Adding the check here would immediately
    // lock the owner out of their own admin panel.
    //
    // The residual risk is narrow: this address already has an account, and
    // Firebase Auth will not let a second account register the same email. The
    // exposure is on the STAFF path (a staff record created for an address
    // nobody has registered yet). Sign-up now sends a verification mail, so
    // once accounts are verified this can be tightened to
    // `request.auth.token.get('email_verified', false) == true` here and in
    // isActiveStaff() — do that only after confirming the owner's own account
    // shows verified in the Firebase console.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email in ['ahmednawaz993@gmail.com'];
    }

    // ---- Staff (delegated admin) -----------------------------------------
    // The main admin can add staff (staff/{lowercased-email}) and grant them
    // a subset of permissions. These helpers gate back-office actions.
    function staffEmail() {
      return request.auth.token.email != null
             ? request.auth.token.email.lower() : 'none';
    }
    function staffData() {
      return get(/databases/$(database)/documents/staff/$(staffEmail())).data;
    }
    // See the note on isAdmin(): the email_verified requirement belongs here
    // too, but cannot be enabled until existing staff accounts are verified.
    function isActiveStaff() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/staff/$(staffEmail()))
             && staffData().get('active', true) == true;
    }
    // True for the super admin OR an active staff member granted [perm].
    function can(perm) {
      return isAdmin()
             || (isActiveStaff()
                 && staffData().get('permissions', {}).get(perm, false) == true);
    }
    // True for the super admin OR any active staff member (used where any
    // back-office user legitimately writes, e.g. notifying a user).
    function isBackOffice() {
      return isAdmin() || isActiveStaff();
    }

    // ---------------------------------------------------------------------
    // Staff roster — only the super admin can manage it; a staff member may
    // read their own record (to load their permissions on the client).
    // ---------------------------------------------------------------------
    match /staff/{staffId} {
      allow read: if isAdmin() || (isSignedIn() && staffEmail() == staffId);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Collection-group READ rules for the back-office admin queues.
    // A Firestore collection-group query (collectionGroup('X')) is ONLY
    // authorized by a rule matched through the recursive {path=**} wildcard.
    // A nested match (e.g. /users/{uid}/payoutAccounts/{id} or
    // /orders/{oid}/cancellationRequests/{id}) secures direct owner/participant
    // reads but is NEVER consulted for a collectionGroup() query — so without
    // these the admin Payout a/c / Cancellations / Returns tabs fail with
    // "Missing or insufficient permissions" no matter how the nested rule is
    // ordered. These ONLY add the admin cross-collection LIST; every write and
    // every owner/participant read stays governed by the per-document nested
    // matches further below (access is the OR of all matching rules).
    // ---------------------------------------------------------------------
    match /{path=**}/payoutAccounts/{accountId} {
      allow read: if can('payments');
    }
    match /{path=**}/cancellationRequests/{requestId} {
      allow read: if can('orders');
    }
    match /{path=**}/returnRequests/{requestId} {
      allow read: if can('orders');
    }
    match /{path=**}/refundRequests/{requestId} {
      allow read: if can('orders');
    }

    // Demo / Play-review accounts bypass ID verification (keep in sync with
    // demoEmails in the app).
    function isDemo() {
      return isSignedIn()
             && request.auth.token.email != null
             && request.auth.token.email.lower() in ['demo@pakbazar24.com'];
    }

    // Whether ID verification is currently required platform-wide (admin can
    // switch it off via config/verification). Missing doc/field => not required.
    function verifyRequired() {
      return exists(/databases/$(database)/documents/config/verification)
             && get(/databases/$(database)/documents/config/verification)
                  .data.get('required', false) == true;
    }

    // True if the signed-in user has passed identity verification, OR
    // verification is switched off, OR they are admin/demo. Gates posting etc.
    function isVerifiedUser() {
      return isAdmin()
             || isDemo()
             || !verifyRequired()
             || (isSignedIn()
                 && get(/databases/$(database)/documents/users/$(request.auth.uid))
                      .data.get('idVerified', false) == true);
    }

    // True unless an admin has suspended this account (admin bypass). Gates all
    // create actions (posting, buying, offering, chatting) so a blocked user
    // can still read/sign in (to see the suspension notice) but cannot act.
    function isNotBlocked() {
      return isAdmin()
             || !(isSignedIn()
                  && get(/databases/$(database)/documents/users/$(request.auth.uid))
                       .data.get('blocked', false) == true);
    }

    // ---------------------------------------------------------------------
    // Listings
    // ---------------------------------------------------------------------
    match /listings/{listingId} {
      // Read-level moderation: a signed-in user may read an ad only if it is
      // approved, it is their own (owner sees their pending/rejected ads in My
      // Ads), or they are an admin. Public list queries MUST filter by
      // `approvalStatus == 'approved'`; owner queries filter by `userId`.
      allow read: if isSignedIn() && (
                    // Cheap, common-case checks first so public browsing never
                    // hits the staff-collection lookups below.
                    resource.data.approvalStatus == 'approved'
                    || resource.data.userId == request.auth.uid
                    || isAdmin()
                    || can('approvals') || can('listings') || can('reports')
                  );

      // Posting an ad requires identity verification (admins bypass).
      // Posting requires verification; new ads MUST start as 'pending' so they
      // go through admin moderation — only an admin may create a pre-approved ad.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked()
                    && (isAdmin()
                        || isDemo()
                        || request.resource.data.approvalStatus == 'pending');

      // Owners can edit/delete their ad, but may never self-approve: an owner
      // edit must either leave the moderation status untouched or reset it to
      // 'pending' (re-review). Only an admin can set 'approved'/'rejected'.
      // Anyone signed in may bump the view/lead counters, but ONLY those.
      allow update: if isSignedIn() && (
                      (resource.data.userId == request.auth.uid
                        && (noSelfApproval() || isDemo())
                        && validInventoryStatus())
                      || onlyBumpsStats()
                      || can('approvals') || can('listings')
                      || ((can('featured') || can('promotions'))
                          && onlyFeatureFields())
                    );
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || can('listings') || can('reports')
                        || (can('deletions')
                            && exists(/databases/$(database)/documents/deletionRequests/$(resource.data.userId))));

      // Non-owners may only increment view/lead counters, nothing else. The
      // increment has to be by one: the rule previously constrained only WHICH
      // keys changed, not their values, so any signed-in user could SET another
      // seller's view or lead counts to an arbitrary number.
      // Bounded on both sides: at most +1 (so nobody can inflate another
      // seller's numbers) and never downward (so nobody can zero them either —
      // views backs the most-viewed rail and the seller's analytics).
      //
      // This relies on the rules engine materialising FieldValue.increment
      // into request.resource.data, which it does. Worth re-confirming in the
      // emulator before deploying, because the client swallows the failure
      // (screen_ad_details.dart catches and ignores), so if it did NOT hold,
      // every view and lead counter would stop updating silently.
      function bumpedByOne(field) {
        return request.resource.data.get(field, 0)
                 <= resource.data.get(field, 0) + 1
               // Lower bound too, or the upper bound alone would let anyone
               // RESET another seller's counters to zero. views backs the
               // most-viewed rail and the seller's analytics.
               && request.resource.data.get(field, 0)
                    >= resource.data.get(field, 0);
      }

      function onlyBumpsStats() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['views', 'calls', 'whatsapps', 'chats'])
               && bumpedByOne('views')
               && bumpedByOne('calls')
               && bumpedByOne('whatsapps')
               && bumpedByOne('chats');
      }

      // An owner edit may not move the ad into a live state itself: either the
      // status is untouched, or it is (re)set to 'pending' for admin review.
      function noSelfApproval() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['approvalStatus'])
               || request.resource.data.approvalStatus == 'pending';
      }

      // Seller-controlled inventory: if an owner edit changes `status`, it must
      // be one of the four supported values (nothing auto-marks a listing sold).
      function validInventoryStatus() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['status'])
               || request.resource.data.status in
                    ['in_stock', 'out_of_stock', 'sold', 'inactive'];
      }

      // Featured/promotions staff may only flip the feature flags on an ad —
      // not edit its content or approval status (least privilege).
      function onlyFeatureFields() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['isFeatured', 'featuredUntil']);
      }
    }

    // ---------------------------------------------------------------------
    // Users: profile, favorites, recently-viewed, and reviews
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Profiles are readable so seller pages can show rating / "Member since".
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Owner may edit their own profile (except protected fields); back-office
      // staff may moderate. The rating aggregate (ratingSum/ratingCount) is NOT
      // client-writable — it is recomputed server-side by the onReviewWrite
      // Cloud Function from the per-user reviews subcollection, so nobody can
      // forge a seller's rating.
      allow update: if isSignedIn() && (
                      isAdmin()
                      || (request.auth.uid == userId && walletUnchanged()
                          && verifiedMatchesToken() && featuredSelfOk()
                          && trialFlagMonotonic() && businessSelfOk())
                      || ((can('users') || can('verifyId') || can('appeals')
                           || can('businessVerify'))
                          && noWalletChange())
                    );
      // Deletion staff may delete a profile only when that user actually filed
      // a deletion request (super admin may delete any).
      allow delete: if isAdmin()
                    || (can('deletions')
                        && exists(/databases/$(database)/documents/deletionRequests/$(userId)));

      // Staff may moderate a profile (block, verify, feature) but never touch
      // the money field or the rating aggregate — walletBalance / ratingSum /
      // ratingCount stay super-admin / Cloud Function only.
      // featuredBusiness* are deliberately NOT listed: staff run the Featured
      // Business tools from the admin panel.
      function noWalletChange() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['walletBalance', 'ratingSum',
                                         'ratingCount', 'verified']);
      }

      // walletBalance is money, idVerified is an identity decision, blocked is
      // an admin suspension, and ratingSum/ratingCount are the server-computed
      // rating aggregate — only admins / Cloud Functions may change these. The
      // owner may edit every other profile field freely (an update is allowed
      // as long as it does not touch any protected field); critically a
      // suspended user cannot clear their own `blocked` flag.
      function walletUnchanged() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['walletBalance', 'idVerified',
                                         'blocked', 'ratingSum',
                                         'ratingCount']);
      }

      // The public "Verified" badge mirrors Firebase's own email_verified
      // claim, and the app syncs it on every launch. Rather than freeze the
      // field (which broke that sync and left the badge write-once), require
      // it to agree with the token — so it stays self-maintaining but can
      // never be self-granted.
      function verifiedMatchesToken() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['verified'])
               || request.resource.data.verified
                    == request.auth.token.get('email_verified', false);
      }

      // Featuring is normally bought through processPurchase, but approved
      // businesses also get one free 90-day trial they activate themselves.
      // Allow the owner to set the featured fields only on the write that
      // consumes that one-time trial flag.
      // The trial flag must be monotonic, or the whole gate is decorative: the
      // owner could clear featuredTrialUsed in one write (which touches no
      // featured* key and so short-circuits this function) and re-activate in
      // the next, forever. The window is bounded too, so a crafted "trial"
      // cannot set featuredBusinessUntil a century out where expireFeatured
      // would never reach it.
      function trialFlagMonotonic() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['featuredTrialUsed'])
               || request.resource.data.featuredTrialUsed == true;
      }

      function featuredSelfOk() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['featuredBusiness',
                                          'featuredBusinessUntil'])
               || (resource.data.get('featuredTrialUsed', false) == false
                   && request.resource.data.get('featuredTrialUsed', false)
                        == true
                   && request.resource.data.get('isBusiness', false) == true
                   && request.resource.data.featuredBusinessUntil
                        < request.time + duration.value(91, 'd'));
      }

      // "Sell as a business" is admin-approved. The owner may REQUEST it
      // (businessStatus 'pending') or withdraw (isBusiness false / status
      // 'none'), but can NEVER approve themselves: only staff with
      // 'businessVerify' (or the super admin) may set isBusiness true or a
      // businessStatus of approved/rejected/suspended. Legacy business accounts
      // (isBusiness already true, no businessStatus) stay untouched — leaving
      // both fields unchanged always passes.
      function businessSelfOk() {
        return (request.resource.data.get('isBusiness', false)
                  == resource.data.get('isBusiness', false)
                || request.resource.data.get('isBusiness', false) == false)
               && (request.resource.data.get('businessStatus', 'none')
                     == resource.data.get('businessStatus', 'none')
                   || request.resource.data.get('businessStatus', 'none')
                        in ['pending', 'none']);
      }

      // Contact PII — email, phone, home address, captured GPS.
      //
      // The parent users/{userId} document is readable by any signed-in user,
      // because seller pages need name / rating / "Member since" and the
      // Stores and Featured Business rails run real list queries over the
      // collection. Rules cannot filter FIELDS on read, so anything private
      // must not live on that document: previously an unfiltered
      // collection('users').get() returned every user's phone number and home
      // address. This subcollection is the private half.
      //
      // Staff with 'users' may read it to run support; nobody but the owner
      // and the super admin may write it.
      match /private/{docId} {
        allow read: if isSignedIn()
                    && (request.auth.uid == userId
                        || can('users') || can('verifyId'));
        allow write: if isSignedIn()
                     && (request.auth.uid == userId || isAdmin());
      }

      match /favorites/{favoriteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // A buyer's saved delivery addresses — private to the owner. Sellers
      // never read these directly; each order carries an immutable address
      // SNAPSHOT instead (see deliveryAddress on the order document).
      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // The buyer's shopping cart — private to the owner. One doc per line
      // item (doc id == listingId). No seller/admin access; carts never hold
      // money and are converted to orders at checkout.
      match /cart/{itemId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Seller payout accounts — private to the seller (and payments admins).
      // The seller manages routing details but can NEVER self-verify:
      // verificationStatus is admin/Cloud-Function only. Buyers can't read them
      // (they are not the owner). New accounts must start 'pending'.
      match /payoutAccounts/{accountId} {
        // Owner reads their own accounts here (direct subcollection query);
        // payments-admin direct GETs also resolve via can('payments'). The
        // admin Payout a/c tab's cross-seller collectionGroup('payoutAccounts')
        // LIST is authorized separately by the recursive {path=**} rule near the
        // top of this file — a nested match like this one is never consulted for
        // a collection-group query.
        allow read: if can('payments')
                    || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn()
                      && request.auth.uid == userId
                      && request.resource.data.verificationStatus == 'pending';
        allow update: if can('payments')
                      || (isSignedIn()
                          && request.auth.uid == userId
                          && request.resource.data.verificationStatus
                             == resource.data.verificationStatus);
        allow delete: if isSignedIn()
                      && (request.auth.uid == userId || can('payments'));
      }

      // People who follow this user. The follower owns their own follow doc
      // (doc id == follower uid) even though it lives under the seller, so they
      // may create/remove it; anyone signed in may read (for the follower count
      // and follow state).
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      // Sellers this user follows (their own private list, mirror of the above).
      match /following/{sellerId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /recentlyViewed/{listingId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Device push tokens (Cloud Functions read these via the Admin SDK).
      match /fcmTokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Saved searches (Cloud Functions scan these via the Admin SDK to alert
      // on matching new ads).
      match /savedSearches/{searchId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Notification history (Cloud Functions write via the Admin SDK; admins
      // may also post a notice, e.g. a verification decision). The owner reads
      // and marks them read.
      match /notifications/{noticeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn()
                     && (request.auth.uid == userId || isBackOffice());
      }

      // Wallet ledger — owner reads; only admins / Cloud Functions write.
      match /walletTransactions/{txId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isAdmin();
      }

      // Users this person has blocked (their own private list).
      match /blocked/{blockedId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Saved ad drafts (private to the owner).
      match /drafts/{draftId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Reviews of this seller. Readable by all; each reviewer owns one doc
      // (doc id == their uid) and can only write a 1-5 star rating as themselves.
      match /reviews/{reviewerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == reviewerId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if isSignedIn() && request.auth.uid == reviewerId;
      }
    }

    // ---------------------------------------------------------------------
    // Promo banners — readable by the app; managed only from the console /
    // a privileged backend (no client writes).
    // ---------------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if can('featured') || can('promotions');
    }

    // ---------------------------------------------------------------------
    // Reports — users may file them, but not read/edit/delete (admin only,
    // via the Firebase console or a privileged backend).
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, delete: if can('reports');
      allow update: if false;
    }

    // Order disputes / problem reports. A buyer opens a dispute on their own
    // order (status must start 'open'); buyer, seller and back-office may read;
    // only back-office may resolve (update). An open dispute blocks the seller
    // payout (enforced server-side in onEscrowAction). Never client-deletable.
    match /disputes/{disputeId} {
      // The dispute must name an order the creator actually bought. Without
      // this, a stranger holding any orderId could open a dispute against it,
      // and the Cloud Function would put that seller's payout on hold
      // indefinitely.
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
                         .data.buyerId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || can('orders') || can('escrow'));
      allow update: if can('orders') || can('escrow');
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Promotions — sellers request a paid Feature; admins approve/manage.
    // ---------------------------------------------------------------------
    match /promotions/{promoId} {
      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.sellerId == request.auth.uid
                      || can('promotions'));
      allow update, delete: if can('promotions');
    }

    // ---------------------------------------------------------------------
    // Orders — direct buy/sell. Buyer creates; buyer/seller/admin read &
    // update (status transitions); admin may delete.
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked()
                    && (request.resource.data.status == 'pending_payment'
                        || request.resource.data.status == 'cod_pending');
      allow read: if isSignedIn() && (
                    resource.data.buyerId == request.auth.uid
                    || resource.data.sellerId == request.auth.uid
                    || can('orders')
                  );
      // Money state (the legacy `status` escrow machine, `paymentStatus`, and
      // every amount/commission/payout field) is written ONLY by Cloud
      // Functions (admin SDK). Clients may advance the FULFILLMENT side:
      //  - a buyer/seller may confirm receipt or cancel a still-unpaid order
      //    (onlySafeOrderChange, unchanged),
      //  - a SELLER may run the shipping flow (accept → process → ship →
      //    deliver) while the money is held (sellerShippingChange),
      //  - a BUYER may confirm delivery after it ships (buyerConfirmChange).
      // None of these may touch a money field (orderMoneyFields()).
      allow update: if can('orders')
                    || (isSignedIn()
                        && (resource.data.buyerId == request.auth.uid
                            || resource.data.sellerId == request.auth.uid)
                        && (onlySafeOrderChange()
                            || (resource.data.sellerId == request.auth.uid
                                && sellerShippingChange())
                            || (resource.data.buyerId == request.auth.uid
                                && buyerConfirmChange())
                            || (resource.data.buyerId == request.auth.uid
                                && buyerCodCompleteChange())));
      allow delete: if can('orders');

      function onlySafeOrderChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['orderStatus', 'status',
                           'completedAt', 'cancelledAt', 'cancelledBy',
                           'cancelledByRole', 'cancelReason',
                           'cancelReasonCode', 'updatedAt'])
               // Delivery confirmation is reachable ONLY through
               // buyerConfirmChange(), which is buyer-scoped. This rule is
               // offered to buyer AND seller, and previously listed the
               // buyerConfirmed* keys, making it a strict superset of the
               // narrow rule: a seller could write buyerConfirmed on their own
               // in_escrow order, satisfy onOrderProgress's release-eligibility
               // check, and unlock their own payout without the buyer ever
               // confirming receipt.
               && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['buyerConfirmed', 'buyerConfirmedAt',
                             'buyerConfirmedBy'])
               && request.resource.data.get('orderStatus', 'pending')
                    != 'buyer_confirmed'
               && (
                 request.resource.data.status == resource.data.status
                 || (resource.data.status == 'pending_payment'
                     && request.resource.data.status == 'cancelled')
                 || (resource.data.status == 'cod_pending'
                     && (request.resource.data.status == 'cancelled'
                         || request.resource.data.status == 'completed'))
               )
               // If a cancel stamp is written, it must name the actor (a buyer
               // can't attribute the cancellation to someone else). Older
               // clients that omit the stamp still pass.
               && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['cancelledBy'])
                   || request.resource.data.cancelledBy == request.auth.uid);
      }

      // Money/payment fields no client may ever write — backend-owned. Note
      // `status` (the escrow machine) is governed by the transition checks
      // above, so it is deliberately not listed here.
      function orderMoneyFields() {
        return ['amount', 'commission', 'sellerPayout', 'paymentStatus',
                'itemSubtotal', 'deliveryFee', 'platformCommissionRate',
                'platformCommissionAmount', 'sellerPayableAmount',
                'releasedAmount', 'refundAmount', 'adjustmentAmount',
                'transactionReference', 'releasedAt', 'releasedBy', 'paidAt',
                'paidToPlatformAt', 'providerTransactionId', 'paymentId'];
      }

      function curOrderStatus() {
        return resource.data.get('orderStatus', 'pending');
      }

      // Seller advances fulfillment while the payment is held (or it's COD).
      // Only shipping fields change; the money state (`status`/`paymentStatus`)
      // stays frozen. Shipping requires a courier + tracking number.
      function sellerShippingChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['orderStatus', 'courierName', 'trackingNumber',
                           'trackingUrl', 'shippedAt', 'deliveredAt',
                           'sellerNote', 'updatedAt'])
               && !request.resource.data.diff(resource.data)
                    .affectedKeys().hasAny(orderMoneyFields())
               && (resource.data.status == 'in_escrow'
                   || resource.data.get('paymentMethod', '') == 'cod')
               && (
                 (curOrderStatus() == 'pending'
                   && request.resource.data.orderStatus == 'accepted')
                 || (curOrderStatus() == 'accepted'
                   && request.resource.data.orderStatus in ['processing',
                                                            'shipped'])
                 || (curOrderStatus() == 'processing'
                   && request.resource.data.orderStatus == 'shipped')
                 || (curOrderStatus() == 'shipped'
                   && request.resource.data.orderStatus == 'delivered')
               )
               // Dispatching an ESCROW order requires a courier + tracking
               // number so the buyer can follow the held-payment delivery. COD
               // orders may be hand-delivered, so tracking is optional there.
               && (request.resource.data.orderStatus != 'shipped'
                   || resource.data.get('paymentMethod', '') == 'cod'
                   || (request.resource.data.get('courierName', '') != ''
                       && request.resource.data.get('trackingNumber', '') != ''));
      }

      // Buyer confirms delivery after the order has shipped/delivered (or on a
      // legacy held order with no shipping flow). Sets orderStatus only; the
      // Cloud Function derives the money consequence (release_pending + payout).
      function buyerConfirmChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['orderStatus', 'buyerConfirmed', 'buyerConfirmedAt',
                           'buyerConfirmedBy'])
               && request.resource.data.status == resource.data.status
               && request.resource.data.buyerConfirmed == true
               && request.resource.data.orderStatus == 'buyer_confirmed'
               && resource.data.status == 'in_escrow'
               // The confirmation must name its actual author, mirroring the
               // cancelledBy pin in onlySafeOrderChange. The Cloud Function
               // cross-checks this against the order's buyerId before treating
               // the release as eligible.
               && request.resource.data.buyerConfirmedBy == request.auth.uid
               && (resource.data.get('orderStatus', 'legacy')
                     in ['shipped', 'delivered', 'legacy']);
      }

      // Buyer confirms receipt of a COD order. There is no held payment — cash
      // was collected on delivery — so the order completes outright rather than
      // going through the escrow release path.
      //
      // This used to ride on onlySafeOrderChange, whose key list included the
      // buyerConfirmed* fields. Removing them from there (so a seller could not
      // forge the buyer's escrow confirmation) also removed the only rule that
      // permitted COD completion, stranding every COD order short of
      // 'completed'. This is the buyer-scoped replacement.
      function buyerCodCompleteChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['orderStatus', 'buyerConfirmed', 'buyerConfirmedAt',
                           'buyerConfirmedBy', 'status', 'completedAt',
                           'updatedAt'])
               && !request.resource.data.diff(resource.data)
                    .affectedKeys().hasAny(orderMoneyFields())
               && resource.data.status == 'cod_pending'
               && request.resource.data.status == 'completed'
               && request.resource.data.buyerConfirmed == true
               && request.resource.data.buyerConfirmedBy == request.auth.uid
               && request.resource.data.orderStatus == 'delivered';
      }

      // Buyer cancellation requests (spec section 8). The buyer files a
      // request; the assigned seller or orders-staff approves/rejects it; the
      // buyer may withdraw while it is still pending. Every money/status effect
      // (cancel, refund, audit, notify) is applied by a Cloud Function via the
      // admin SDK — clients only move requestStatus through its allowed states.
      match /cancellationRequests/{requestId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        allow read: if isSignedIn() && (
                      can('orders')
                      || parentOrder().buyerId == request.auth.uid
                      || parentOrder().sellerId == request.auth.uid
                    );
        allow create: if isSignedIn()
                      && parentOrder().buyerId == request.auth.uid
                      && request.resource.data.requestStatus == 'pending'
                      && request.resource.data.buyerId == request.auth.uid
                      && request.resource.data.requestedBy == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.requestStatus == 'pending'
                      && (
                        (
                          (parentOrder().sellerId == request.auth.uid
                            || can('orders'))
                          && request.resource.data.requestStatus
                               in ['approved', 'rejected']
                        )
                        || (parentOrder().buyerId == request.auth.uid
                            && request.resource.data.requestStatus == 'withdrawn')
                      );
        allow delete: if false;
      }

      // Buyer return requests (Phase 4). Same shape/authority as cancellation
      // requests: buyer files, seller/orders-staff decides, buyer withdraws
      // while pending. The refund + 'returned' status are applied by a Cloud
      // Function (admin SDK); clients only move requestStatus.
      match /returnRequests/{requestId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        allow read: if isSignedIn() && (
                      can('orders')
                      || parentOrder().buyerId == request.auth.uid
                      || parentOrder().sellerId == request.auth.uid
                    );
        allow create: if isSignedIn()
                      && parentOrder().buyerId == request.auth.uid
                      && request.resource.data.requestStatus == 'pending'
                      && request.resource.data.buyerId == request.auth.uid
                      && request.resource.data.requestedBy == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.requestStatus == 'pending'
                      && (
                        (
                          (parentOrder().sellerId == request.auth.uid
                            || can('orders'))
                          && request.resource.data.requestStatus
                               in ['approved', 'rejected']
                        )
                        || (parentOrder().buyerId == request.auth.uid
                            && request.resource.data.requestStatus == 'withdrawn')
                      );
        allow delete: if false;
      }

      // Buyer refund requests (admin-controlled). Same file/authority shape as
      // cancellation/return requests EXCEPT only orders-staff (not the seller)
      // may approve/reject; the buyer may withdraw while pending. The refund
      // itself is issued by a Cloud Function (admin SDK) via the escrow path —
      // clients only move requestStatus through its allowed states.
      match /refundRequests/{requestId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        allow read: if isSignedIn() && (
                      can('orders')
                      || parentOrder().buyerId == request.auth.uid
                      || parentOrder().sellerId == request.auth.uid
                    );
        allow create: if isSignedIn()
                      && parentOrder().buyerId == request.auth.uid
                      && request.resource.data.requestStatus == 'pending'
                      && request.resource.data.buyerId == request.auth.uid
                      && request.resource.data.requestedBy == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.requestStatus == 'pending'
                      && (
                        (
                          can('orders')
                          && request.resource.data.requestStatus
                               in ['approved', 'rejected']
                        )
                        || (parentOrder().buyerId == request.auth.uid
                            && request.resource.data.requestStatus == 'withdrawn')
                      );
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Master orders — a buyer's multi-seller checkout intent (Phase 3). The
    // buyer writes one master; a Cloud Function (onMasterOrderCreated, admin
    // SDK) fans it out into per-seller orders/{id}. The buyer never writes the
    // per-seller money fields — those are server-authoritative.
    // ---------------------------------------------------------------------
    match /masterOrders/{masterId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked()
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid || can('orders'));
      // Fan-out + admin edits only (the function uses the admin SDK, which
      // bypasses rules); clients can't mutate a master after creating it.
      allow update, delete: if can('orders');
    }

    // Server-only sequence counters (order numbers). Written by Cloud Functions
    // via the admin SDK; no client access.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Escrow payments — the buyer initiates a payment; Cloud Functions
    // confirm it and settle the order. Clients never write money state.
    // ---------------------------------------------------------------------
    match /payments/{paymentId} {
      // provider is restricted so a client can never submit a self-capturing
      // provider; only manual (admin-confirmed) and payfast (gateway-verified)
      // ever move money, and both still require a server-side confirmation step.
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'initiated'
                    && request.resource.data.provider in ['manual', 'payfast'];
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid
                      || can('payments'));
      allow update, delete: if false; // settled only by Cloud Functions
    }

    // Admin confirm/reject instructions for manual payments — processed by
    // onPaymentAction.
    match /paymentActions/{actionId} {
      allow create: if can('payments')
                    && request.resource.data.status == 'pending';
      allow read: if can('payments');
      allow update, delete: if false; // Cloud Functions only
    }

    // Admin release/refund instructions — processed by onEscrowAction.
    match /escrowActions/{actionId} {
      allow create: if can('escrow')
                    && request.resource.data.status == 'pending';
      allow read: if can('escrow');
      allow update, delete: if false; // Cloud Functions only
    }

    // Immutable money ledger — written only by Cloud Functions.
    match /ledger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-order seller payout records (doc id == orderId → one payout per
    // order, the idempotency key). Created and settled ONLY by Cloud Functions:
    // sellerPayableAmount, releaseStatus, transactionReference and releasedAmount
    // are all backend-owned, so a seller can neither pay themselves nor edit the
    // amount. A seller reads their OWN payout; payments admins read all; buyers
    // never see them.
    match /sellerPayouts/{payoutId} {
      allow read: if isSignedIn()
                  && (resource.data.sellerId == request.auth.uid
                      || can('payments'));
      allow write: if false; // Cloud Functions only
    }

    // Immutable financial audit trail (section 12) — payment held, buyer
    // confirmed, commission calculated, payout released/held/rejected, refund,
    // dispute, adjustment. Written only by Cloud Functions; payments admins may
    // read; no client may ever write, edit or delete.
    match /financialAuditLog/{auditId} {
      // Read-only monitoring feed for back-office: the dedicated 'activity'
      // monitor, plus payments/orders/escrow staff who already work these events.
      allow read: if can('activity') || can('payments')
                  || can('orders') || can('escrow');
      allow write: if false; // Cloud Functions only
    }

    // ---------------------------------------------------------------------
    // Wallet top-ups — user requests credit; admin approves (and credits the
    // balance). Cloud Functions / admin process them.
    // ---------------------------------------------------------------------
    match /walletTopups/{topupId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('topups'));
      allow update, delete: if can('topups');
    }

    // ---------------------------------------------------------------------
    // Identity verifications — the user submits a selfie + CNIC; the admin
    // reviews and approves. The user can read/write their own record but the
    // authoritative `idVerified` flag lives on the user doc (admin-only).
    // ---------------------------------------------------------------------
    match /verifications/{userId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || can('verifyId'));
      // The owner may submit/resubmit, but may only set status 'pending'. Only
      // an admin/staff may mark a record 'approved'/'rejected', so a user cannot
      // make their own request look reviewed and skip the queue. (The
      // authoritative idVerified flag on the user doc stays admin/staff-only.)
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending';
      allow update: if can('verifyId')
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && request.resource.data.status == 'pending');
      allow delete: if can('verifyId');
    }

    // ---------------------------------------------------------------------
    // Feedback — help requests and suggestions from the Help & Feedback sheet.
    // A signed-in user submits their own; only the author or an admin can read;
    // admins resolve/delete.
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('feedback'));
      allow update, delete: if can('feedback');
    }

    // Review-prompt funnel analytics — anonymous events (no star rating, no PII
    // beyond the uid). Users may only append their own events; admins read.
    match /reviewPromptEvents/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Immutable audit log of payout-account changes (add/update/delete by the
    // seller; verify/reject/suspend by admins). Never editable by any client.
    match /payoutAccountAudit/{auditId} {
      allow create: if isSignedIn()
                    && (request.resource.data.sellerId == request.auth.uid
                        || can('payments'));
      allow read: if can('payments');
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Customer Care — 24/7 support tickets. A user opens a ticket and chats
    // with support in its messages subcollection; staff with the 'support'
    // permission read all tickets, reply, and move them through open ->
    // in_progress -> resolved (target resolution 24h, tracked by slaDueAt).
    // ---------------------------------------------------------------------
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('support'));
      // Support staff manage a ticket fully; the owner may only bump the thread
      // metadata and (re)open it — never mark their own ticket resolved or
      // change the parties.
      allow update: if can('support')
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && onlyOwnerTicketChange());
      allow delete: if can('support');

      function onlyOwnerTicketChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'lastMessage', 'lastSenderRole',
                           'updatedAt', 'readAt', 'deliveredAt'])
               && (request.resource.data.status == resource.data.status
                   || request.resource.data.status == 'open');
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && (ticketOwner() == request.auth.uid || can('support'));
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && (ticketOwner() == request.auth.uid || can('support'));
        allow update, delete: if false;

        function ticketOwner() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId))
                   .data.userId;
        }
      }
    }

    // ---------------------------------------------------------------------
    // Appeals — a suspended user asks to be reinstated, committing to fix the
    // violation. Creation is deliberately NOT gated by isNotBlocked() (a
    // blocked user must be able to appeal); the owner reads their own appeals,
    // admins read all and resolve (approve -> unblock, or reject).
    // ---------------------------------------------------------------------
    match /appeals/{appealId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('appeals'));
      allow update, delete: if can('appeals');
    }

    // ---------------------------------------------------------------------
    // Presence — WhatsApp-style online / last-seen. Each user writes only their
    // own presence/{uid}; support agents also keep the shared presence/support
    // doc fresh so users can see when Customer Care is live. Any signed-in user
    // may read presence to render who is online.
    // ---------------------------------------------------------------------
    match /presence/{presenceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && (presenceId == request.auth.uid
                       || (presenceId == 'support' && can('support')));
    }

    // ---------------------------------------------------------------------
    // Support agent device tokens — a Customer Care agent registers this
    // device's FCM token here so the notifyOnNewSupportMessage function can
    // push new-message alerts to all agents. Read is server-only (admin SDK
    // bypasses rules); an agent writes only their own token, and may remove it.
    // ---------------------------------------------------------------------
    match /supportTokens/{token} {
      allow read: if false;
      allow create, update: if isSignedIn()
                            && can('support')
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && (can('support')
                        || resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // Account-deletion requests — a user asks the admin to delete their
    // account and data (doc id == uid). The owner files/updates their own
    // pending request; staff with the 'deletions' permission read and resolve.
    // ---------------------------------------------------------------------
    match /deletionRequests/{reqId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('deletions'));
      allow update: if (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'pending')
                    || can('deletions');
      allow delete: if can('deletions');
    }

    // ---------------------------------------------------------------------
    // App config — e.g. the platform's receiving account shown on the top-up
    // sheet. Readable by any signed-in user; only admins can change it.
    // ---------------------------------------------------------------------
    match /config/{docId} {
      // The category catalog is public: the app loads it in main(), before auth
      // state is known, and a signed-out visitor browsing the website needs the
      // same category strip everyone else sees. It carries no private data.
      // Everything else in config stays signed-in only.
      // appGate is public for the same reason plus a stronger one: it is what
      // tells an outdated or locked-out client to stop, and that has to work
      // before sign-in.
      allow read: if isSignedIn()
                  || docId == 'categories'
                  || docId == 'appGate';
      // The receiving account is money-critical → paymentAccount staff only.
      // The featuring master switch → featured staff. Anything else → super
      // admin. (A featured/marketing role must NOT change the payout account.)
      allow write: if (docId == 'paymentAccount' && can('paymentAccount'))
                   || (docId == 'commission' && can('payments'))
                   || (docId == 'featuring' && can('featured'))
                   || (docId == 'verification' && can('verifyId'))
                   || (docId == 'customerCare' && can('support'))
                   || (docId == 'categories' && can('categories'))
                   || isAdmin();
    }

    // ---------------------------------------------------------------------
    // Lucky Draw entries — one doc per user (id == uid). The owner maintains
    // their own participation record (name/phone/shareCount) but can NEVER set
    // themselves as a winner; only an admin marks winners. Admins read the full
    // list to run the draw.
    // ---------------------------------------------------------------------
    match /luckyDrawEntries/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // shareCount decides the draw: the admin winner-picker orders by it and
      // flags entries at >= 5. It was freely self-settable, so an entrant could
      // rank themselves first for a PKR 100,000 prize. Creation pins it to 0
      // and updates may only step it up by one at a time, matching the
      // FieldValue.increment(1) the Invite screen actually performs.
      // Upper bounds rather than equality: the Invite screen writes
      // FieldValue.increment(1) through a set(merge:true), so the very first
      // share CREATES the document with shareCount resolving to 1, not 0. An
      // upper bound also holds whether or not the rules engine resolves the
      // increment transform into request.resource.data — an attacker setting
      // an explicit large value is still rejected either way.
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && request.resource.data.get('isWinner', false) == false
                        && request.resource.data.get('shareCount', 0) <= 1);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && request.resource.data.get('isWinner', false) == false
                        && request.resource.data.get('shareCount', 0)
                             <= resource.data.get('shareCount', 0) + 1);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Seller withdrawals — a seller requests a payout; Cloud Functions reserve
    // the funds and settle. Clients never write money state.
    // ---------------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('withdrawals'));
      allow update, delete: if false; // settled only by Cloud Functions
    }

    // Admin pay/reject instructions — processed by onWithdrawalAction.
    match /withdrawalActions/{actionId} {
      allow create: if can('withdrawals')
                    && request.resource.data.status == 'pending';
      allow read: if can('withdrawals');
      allow update, delete: if false; // Cloud Functions only
    }

    // ---------------------------------------------------------------------
    // Admin-composed push notifications ("Notify" tab). The panel writes one
    // doc with status 'pending'; onAdminBroadcastCreated re-authorises it
    // server-side, sends it, and writes the outcome back.
    //
    // createdByEmail is pinned to the caller's own verified token email
    // because the Cloud Function authorises against THAT field — without this
    // an author could name a higher-privileged admin and borrow their rights.
    // A delivered notification cannot be recalled, so no client may edit or
    // delete these; the record of what was sent stays intact.
    // ---------------------------------------------------------------------
    match /adminBroadcasts/{broadcastId} {
      allow create: if can('broadcasts')
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdByEmail == staffEmail();
      allow read: if can('broadcasts');
      allow update, delete: if false; // Cloud Functions only
    }

    // ---------------------------------------------------------------------
    // Purchases — user spends wallet balance on a feature. A Cloud Function
    // (processPurchase) validates the balance and applies the effect.
    // ---------------------------------------------------------------------
    // The price a purchase costs is decided server-side by processPurchase from
    // a price table; `amount` written here is advisory only and is overwritten.
    // A purchase must start pending so the function is the thing that settles
    // it.
    match /purchases/{purchaseId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('status', 'pending')
                         == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('purchases'));
      allow update, delete: if can('purchases');
    }

    // ---------------------------------------------------------------------
    // Offers — price negotiation. Buyer creates; buyer/seller/admin read &
    // update (accept/counter/decline); admin may delete.
    // ---------------------------------------------------------------------
    match /offers/{offerId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked();
      allow read: if isSignedIn() && (
                      resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || can('offers')
                    );
      // A participant may only advance the negotiation status and set the
      // counter/agreed amount — never rewrite offerAmount, the parties, or the
      // listing. Without this a buyer could lower offerAmount after the seller
      // accepts and buy the item for almost nothing (the order copies this
      // amount). Admins (can('offers')) are unrestricted.
      // Transitions are scoped to the party entitled to make them. Previously
      // both parties shared one rule that only checked THAT you were a party,
      // never WHICH party — so a buyer could create an offer of Rs 1, accept
      // it themselves with agreedAmount 1, and hold a genuine-looking accepted
      // offer against a listing of any price.
      allow update: if isSignedIn() && (
                      can('offers')
                      || (resource.data.sellerId == request.auth.uid
                          && onlySafeOfferChange()
                          && agreedAmountOnlyOnAccept()
                          && sellerOfferTransition())
                      || (resource.data.buyerId == request.auth.uid
                          && onlySafeOfferChange()
                          && buyerAgreedOk()
                          && buyerOfferTransition())
                    );
      allow delete: if can('offers');

      // Only status and the counter/agreed amounts may change; offerAmount, the
      // parties and the listing stay exactly as created.
      function onlySafeOfferChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'counterAmount', 'agreedAmount']);
      }

      // The seller decides the outcome of a negotiation: accept, counter or
      // decline. They may never mark it 'ordered' — only the buyer places the
      // order.
      function sellerOfferTransition() {
        return request.resource.data.status == resource.data.status
               || (resource.data.status == 'pending'
                   && request.resource.data.status in
                      ['accepted', 'countered', 'declined'])
               || (resource.data.status == 'countered'
                   && request.resource.data.status in
                      ['accepted', 'declined']);
      }

      // The buyer may withdraw their offer, decline a counter, or convert an
      // agreed one into an order. They may never move an offer to 'accepted'.
      function buyerOfferTransition() {
        return request.resource.data.status == resource.data.status
               || (resource.data.status == 'pending'
                   && request.resource.data.status == 'cancelled')
               || (resource.data.status == 'countered'
                   && request.resource.data.status == 'declined')
               || (resource.data.status in ['accepted', 'countered']
                   && request.resource.data.status in ['ordered', 'cancelled']);
      }

      // agreedAmount is the price the resulting order copies, so the buyer may
      // never invent one. They MAY pin it when converting to an order —
      // accepting a seller's counter writes counterAmount into agreedAmount —
      // but only to a value the negotiation already recorded on this document.
      // The ONLY case where the buyer may introduce agreedAmount is accepting
      // the seller's counter, and then only at exactly the counter price.
      //
      // An earlier version also allowed "== offerAmount", which reopened the
      // hole this whole block exists to close: offer Rs 1, let the seller
      // counter at Rs 450,000, then convert to an order with agreedAmount 1 —
      // the transition is countered->ordered, so the unscoped alternative
      // matched and the server's equality check passed against it. The accept
      // path does not need it: the seller writes agreedAmount when accepting,
      // so the buyer's write is a no-op caught by the first clause.
      function buyerAgreedOk() {
        return request.resource.data.get('agreedAmount', 0)
                 == resource.data.get('agreedAmount', 0)
               || (resource.data.status == 'countered'
                   && request.resource.data.status == 'ordered'
                   && request.resource.data.get('agreedAmount', 0)
                        == resource.data.get('counterAmount', 0));
      }

      // The seller may only introduce or change agreedAmount at the moment of
      // accepting — not afterwards, which would let them raise the price out
      // from under a buyer who had already agreed.
      function agreedAmountOnlyOnAccept() {
        return request.resource.data.get('agreedAmount', 0)
                 == resource.data.get('agreedAmount', 0)
               || request.resource.data.status == 'accepted';
      }
    }

    // ---------------------------------------------------------------------
    // Chats — only the two participants can see or write a thread.
    // ---------------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participants
                      || can('chats'));

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && isVerifiedUser()
                    && isNotBlocked();

      // Updating lastMessage/lastTime — caller must already be a participant,
      // and the participant list is immutable (a participant must not be able to
      // swap in a different party and hijack / expose the thread).
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isParticipant() || can('chats'));
        allow create: if isSignedIn()
                      && isParticipant()
                      && isNotBlocked()
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;

        function isParticipant() {
          return request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.participants;
        }
      }
    }
  }
}
