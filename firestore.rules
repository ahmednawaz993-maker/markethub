rules_version = '2';

// MarketHub production security rules.
// Data model:
//   listings/{id}                      public marketplace ads
//   users/{uid}                        profile (member-since)
//   users/{uid}/favorites/{listingId}  per-user saved ads
//   reports/{id}                       abuse reports (write-only for users)
//   chats/{chatId}                     buyer<->seller thread
//   chats/{chatId}/messages/{id}       individual messages
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin (full access) by verified token email (keep in sync with
    // adminEmails in the app).
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email in ['ahmednawaz993@gmail.com'];
    }

    // ---- Staff (delegated admin) -----------------------------------------
    // The main admin can add staff (staff/{lowercased-email}) and grant them
    // a subset of permissions. These helpers gate back-office actions.
    function staffEmail() {
      return request.auth.token.email != null
             ? request.auth.token.email.lower() : 'none';
    }
    function staffData() {
      return get(/databases/$(database)/documents/staff/$(staffEmail())).data;
    }
    function isActiveStaff() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/staff/$(staffEmail()))
             && staffData().get('active', true) == true;
    }
    // True for the super admin OR an active staff member granted [perm].
    function can(perm) {
      return isAdmin()
             || (isActiveStaff()
                 && staffData().get('permissions', {}).get(perm, false) == true);
    }
    // True for the super admin OR any active staff member (used where any
    // back-office user legitimately writes, e.g. notifying a user).
    function isBackOffice() {
      return isAdmin() || isActiveStaff();
    }

    // ---------------------------------------------------------------------
    // Staff roster — only the super admin can manage it; a staff member may
    // read their own record (to load their permissions on the client).
    // ---------------------------------------------------------------------
    match /staff/{staffId} {
      allow read: if isAdmin() || (isSignedIn() && staffEmail() == staffId);
      allow write: if isAdmin();
    }

    // Demo / Play-review accounts bypass ID verification (keep in sync with
    // demoEmails in the app).
    function isDemo() {
      return isSignedIn()
             && request.auth.token.email != null
             && request.auth.token.email.lower() in ['demo@pakbazar24.com'];
    }

    // True if the signed-in user has passed identity verification (admin/demo
    // bypass). Used to require ID verification before posting ads.
    function isVerifiedUser() {
      return isAdmin()
             || isDemo()
             || (isSignedIn()
                 && get(/databases/$(database)/documents/users/$(request.auth.uid))
                      .data.get('idVerified', false) == true);
    }

    // True unless an admin has suspended this account (admin bypass). Gates all
    // create actions (posting, buying, offering, chatting) so a blocked user
    // can still read/sign in (to see the suspension notice) but cannot act.
    function isNotBlocked() {
      return isAdmin()
             || !(isSignedIn()
                  && get(/databases/$(database)/documents/users/$(request.auth.uid))
                       .data.get('blocked', false) == true);
    }

    // ---------------------------------------------------------------------
    // Listings
    // ---------------------------------------------------------------------
    match /listings/{listingId} {
      // Read-level moderation: a signed-in user may read an ad only if it is
      // approved, it is their own (owner sees their pending/rejected ads in My
      // Ads), or they are an admin. Public list queries MUST filter by
      // `approvalStatus == 'approved'`; owner queries filter by `userId`.
      allow read: if isSignedIn() && (
                    // Cheap, common-case checks first so public browsing never
                    // hits the staff-collection lookups below.
                    resource.data.approvalStatus == 'approved'
                    || resource.data.userId == request.auth.uid
                    || isAdmin()
                    || can('approvals') || can('listings') || can('reports')
                  );

      // Posting an ad requires identity verification (admins bypass).
      // Posting requires verification; new ads MUST start as 'pending' so they
      // go through admin moderation — only an admin may create a pre-approved ad.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked()
                    && (isAdmin()
                        || isDemo()
                        || request.resource.data.approvalStatus == 'pending');

      // Owners can edit/delete their ad, but may never self-approve: an owner
      // edit must either leave the moderation status untouched or reset it to
      // 'pending' (re-review). Only an admin can set 'approved'/'rejected'.
      // Anyone signed in may bump the view/lead counters, but ONLY those.
      allow update: if isSignedIn() && (
                      (resource.data.userId == request.auth.uid
                        && (noSelfApproval() || isDemo()))
                      || onlyBumpsStats()
                      || can('approvals') || can('listings')
                      || ((can('featured') || can('promotions'))
                          && onlyFeatureFields())
                    );
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || can('listings') || can('reports'));

      // Non-owners may only increment view/lead counters, nothing else.
      function onlyBumpsStats() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['views', 'calls', 'whatsapps', 'chats']);
      }

      // An owner edit may not move the ad into a live state itself: either the
      // status is untouched, or it is (re)set to 'pending' for admin review.
      function noSelfApproval() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['approvalStatus'])
               || request.resource.data.approvalStatus == 'pending';
      }

      // Featured/promotions staff may only flip the feature flags on an ad —
      // not edit its content or approval status (least privilege).
      function onlyFeatureFields() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['isFeatured', 'featuredUntil']);
      }
    }

    // ---------------------------------------------------------------------
    // Users: profile, favorites, recently-viewed, and reviews
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Profiles are readable so seller pages can show rating / "Member since".
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Owner may edit their profile; anyone signed in may only adjust the
      // aggregate rating fields (when leaving a review).
      allow update: if isSignedIn() && (
                      isAdmin()
                      || (request.auth.uid == userId && walletUnchanged())
                      || onlyRatingChange()
                      || ((can('users') || can('verifyId') || can('appeals'))
                          && noWalletChange())
                    );
      allow delete: if false;

      // Staff may moderate a profile (block, verify, feature) but never touch
      // the money field — walletBalance stays super-admin / Cloud Function only.
      function noWalletChange() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['walletBalance']);
      }

      // walletBalance is money, idVerified is an identity decision, and blocked
      // is an admin suspension — only admins / Cloud Functions may change these.
      // The owner may edit every other profile field freely (an update is
      // allowed as long as it does not touch any protected field); critically a
      // suspended user cannot clear their own `blocked` flag.
      function walletUnchanged() {
        return !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['walletBalance', 'idVerified',
                                         'blocked']);
      }

      function onlyRatingChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ratingSum', 'ratingCount']);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // People who follow this user. The follower owns their own follow doc
      // (doc id == follower uid) even though it lives under the seller, so they
      // may create/remove it; anyone signed in may read (for the follower count
      // and follow state).
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      // Sellers this user follows (their own private list, mirror of the above).
      match /following/{sellerId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /recentlyViewed/{listingId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Device push tokens (Cloud Functions read these via the Admin SDK).
      match /fcmTokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Saved searches (Cloud Functions scan these via the Admin SDK to alert
      // on matching new ads).
      match /savedSearches/{searchId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Notification history (Cloud Functions write via the Admin SDK; admins
      // may also post a notice, e.g. a verification decision). The owner reads
      // and marks them read.
      match /notifications/{noticeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn()
                     && (request.auth.uid == userId || isBackOffice());
      }

      // Wallet ledger — owner reads; only admins / Cloud Functions write.
      match /walletTransactions/{txId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isAdmin();
      }

      // Users this person has blocked (their own private list).
      match /blocked/{blockedId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Saved ad drafts (private to the owner).
      match /drafts/{draftId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Reviews of this seller. Readable by all; each reviewer owns one doc
      // (doc id == their uid) and can only write a 1-5 star rating as themselves.
      match /reviews/{reviewerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == reviewerId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if isSignedIn() && request.auth.uid == reviewerId;
      }
    }

    // ---------------------------------------------------------------------
    // Promo banners — readable by the app; managed only from the console /
    // a privileged backend (no client writes).
    // ---------------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if can('featured') || can('promotions');
    }

    // ---------------------------------------------------------------------
    // Reports — users may file them, but not read/edit/delete (admin only,
    // via the Firebase console or a privileged backend).
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, delete: if can('reports');
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // Promotions — sellers request a paid Feature; admins approve/manage.
    // ---------------------------------------------------------------------
    match /promotions/{promoId} {
      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.sellerId == request.auth.uid
                      || can('promotions'));
      allow update, delete: if can('promotions');
    }

    // ---------------------------------------------------------------------
    // Orders — direct buy/sell. Buyer creates; buyer/seller/admin read &
    // update (status transitions); admin may delete.
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked()
                    && (request.resource.data.status == 'pending_payment'
                        || request.resource.data.status == 'cod_pending');
      allow read: if isSignedIn() && (
                    resource.data.buyerId == request.auth.uid
                    || resource.data.sellerId == request.auth.uid
                    || can('orders')
                  );
      // Escrow money transitions (in_escrow / released / refunded) and the
      // amount/commission/payout fields are written ONLY by Cloud Functions
      // (admin SDK). A buyer/seller client may confirm receipt or cancel a
      // still-unpaid order — nothing money-bearing.
      allow update: if can('orders')
                    || (isSignedIn()
                        && (resource.data.buyerId == request.auth.uid
                            || resource.data.sellerId == request.auth.uid)
                        && onlySafeOrderChange());
      allow delete: if can('orders');

      function onlySafeOrderChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['buyerConfirmed', 'buyerConfirmedAt', 'status',
                           'completedAt'])
               && (
                 request.resource.data.status == resource.data.status
                 || (resource.data.status == 'pending_payment'
                     && request.resource.data.status == 'cancelled')
                 || (resource.data.status == 'cod_pending'
                     && (request.resource.data.status == 'cancelled'
                         || request.resource.data.status == 'completed'))
               );
      }
    }

    // ---------------------------------------------------------------------
    // Escrow payments — the buyer initiates a payment; Cloud Functions
    // confirm it and settle the order. Clients never write money state.
    // ---------------------------------------------------------------------
    match /payments/{paymentId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'initiated';
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid
                      || can('payments'));
      allow update, delete: if false; // settled only by Cloud Functions
    }

    // Admin confirm/reject instructions for manual payments — processed by
    // onPaymentAction.
    match /paymentActions/{actionId} {
      allow create: if can('payments')
                    && request.resource.data.status == 'pending';
      allow read: if can('payments');
      allow update, delete: if false; // Cloud Functions only
    }

    // Admin release/refund instructions — processed by onEscrowAction.
    match /escrowActions/{actionId} {
      allow create: if can('escrow')
                    && request.resource.data.status == 'pending';
      allow read: if can('escrow');
      allow update, delete: if false; // Cloud Functions only
    }

    // Immutable money ledger — written only by Cloud Functions.
    match /ledger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Wallet top-ups — user requests credit; admin approves (and credits the
    // balance). Cloud Functions / admin process them.
    // ---------------------------------------------------------------------
    match /walletTopups/{topupId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('topups'));
      allow update, delete: if can('topups');
    }

    // ---------------------------------------------------------------------
    // Identity verifications — the user submits a selfie + CNIC; the admin
    // reviews and approves. The user can read/write their own record but the
    // authoritative `idVerified` flag lives on the user doc (admin-only).
    // ---------------------------------------------------------------------
    match /verifications/{userId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || can('verifyId'));
      // The owner may submit/resubmit, but may only set status 'pending'. Only
      // an admin/staff may mark a record 'approved'/'rejected', so a user cannot
      // make their own request look reviewed and skip the queue. (The
      // authoritative idVerified flag on the user doc stays admin/staff-only.)
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending';
      allow update: if can('verifyId')
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && request.resource.data.status == 'pending');
      allow delete: if can('verifyId');
    }

    // ---------------------------------------------------------------------
    // Feedback — help requests and suggestions from the Help & Feedback sheet.
    // A signed-in user submits their own; only the author or an admin can read;
    // admins resolve/delete.
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('feedback'));
      allow update, delete: if can('feedback');
    }

    // ---------------------------------------------------------------------
    // Appeals — a suspended user asks to be reinstated, committing to fix the
    // violation. Creation is deliberately NOT gated by isNotBlocked() (a
    // blocked user must be able to appeal); the owner reads their own appeals,
    // admins read all and resolve (approve -> unblock, or reject).
    // ---------------------------------------------------------------------
    match /appeals/{appealId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('appeals'));
      allow update, delete: if can('appeals');
    }

    // ---------------------------------------------------------------------
    // App config — e.g. the platform's receiving account shown on the top-up
    // sheet. Readable by any signed-in user; only admins can change it.
    // ---------------------------------------------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      // The receiving account is money-critical → paymentAccount staff only.
      // The featuring master switch → featured staff. Anything else → super
      // admin. (A featured/marketing role must NOT change the payout account.)
      allow write: if (docId == 'paymentAccount' && can('paymentAccount'))
                   || (docId == 'featuring' && can('featured'))
                   || isAdmin();
    }

    // ---------------------------------------------------------------------
    // Seller withdrawals — a seller requests a payout; Cloud Functions reserve
    // the funds and settle. Clients never write money state.
    // ---------------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('withdrawals'));
      allow update, delete: if false; // settled only by Cloud Functions
    }

    // Admin pay/reject instructions — processed by onWithdrawalAction.
    match /withdrawalActions/{actionId} {
      allow create: if can('withdrawals')
                    && request.resource.data.status == 'pending';
      allow read: if can('withdrawals');
      allow update, delete: if false; // Cloud Functions only
    }

    // ---------------------------------------------------------------------
    // Purchases — user spends wallet balance on a feature. A Cloud Function
    // (processPurchase) validates the balance and applies the effect.
    // ---------------------------------------------------------------------
    match /purchases/{purchaseId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || can('purchases'));
      allow update, delete: if can('purchases');
    }

    // ---------------------------------------------------------------------
    // Offers — price negotiation. Buyer creates; buyer/seller/admin read &
    // update (accept/counter/decline); admin may delete.
    // ---------------------------------------------------------------------
    match /offers/{offerId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && isVerifiedUser()
                    && isNotBlocked();
      allow read, update: if isSignedIn() && (
                      resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || can('offers')
                    );
      allow delete: if can('offers');
    }

    // ---------------------------------------------------------------------
    // Chats — only the two participants can see or write a thread.
    // ---------------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participants
                      || can('chats'));

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && isVerifiedUser()
                    && isNotBlocked();

      // Updating lastMessage/lastTime — caller must already be a participant
      // and must not remove themselves from the thread.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.auth.uid in request.resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isParticipant() || can('chats'));
        allow create: if isSignedIn()
                      && isParticipant()
                      && isNotBlocked()
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;

        function isParticipant() {
          return request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.participants;
        }
      }
    }
  }
}
